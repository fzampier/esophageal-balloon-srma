    "ptp_computation": {
      "method": "absolute_pes_subtraction",
      "method_verbatim": {
        "value": "Ptp is the difference between airway pressure (Paw) and Ppl: Ptp = Paw − Ppl",
        "provenance": {
          "quote": "Ptp is the difference between airway pressure (Paw) and Ppl: Ptp = Paw − Ppl",
          "location": "Introduction, para 4"
        }
      },
      "pes_correction_applied": {
        "value": "Chest wall contribution defined as approximately 10 cmH2O; safe plateau = 20 cmH2O + Pes.",
        "provenance": {
          "quote": "With the chest wall contribution defined as approximately 10 cmH2O, this translated to a delta pressure threshold of 15-20 cmH2O above the Pes at inspiratory hold",
          "location": "Methods, Esophageal manometry technique, para 3"
        }
      }
    },
    "peep_titration_target": {
      "strategy": "other",
      "strategy_verbatim": {
        "value": "End-expiratory Pes was used to determine optimal PEEP. First, an expiratory hold maneuver was performed by the ventilator to determine the total PEEP in the patient. The total PEEP is equal to the sum of the set PEEP of the ventilator and the Auto-PEEP with which a patient was experiencing at the time of measurement. Subtracting the optimal PEEP by the total PEEP determines by how much a ventilator's PEEP setting must be adjusted (Δ-PEEP) to achieve the optimal PEEP: Δ-PEEP = Optimal PEEP − Total PEEP.",
        "provenance": {
          "quote": "End-expiratory Pes was used to determine optimal PEEP. First, an expiratory hold maneuver was performed by the ventilator to determine the total PEEP in the patient. The total PEEP is equal to the sum of the set PEEP of the ventilator and the Auto-PEEP with which a patient was experiencing at the time of measurement. Subtracting the optimal PEEP by the total PEEP determines by how much a ventilator's PEEP setting must be adjusted (Δ-PEEP) to achieve the optimal PEEP: Δ-PEEP = Optimal PEEP − Total PEEP.",
          "location": "Methods, Esophageal manometry technique, para 4"
        }
      },
      "end_expiratory_ptp_target_low_cmh2o": null,
      "end_expiratory_ptp_target_high_cmh2o": null,
      "end_inspiratory_ptp_limit_cmh2o": null,
      "driving_ptp_limit_cmh2o": null,
      "peep_upper_limit_cmh2o": null,
      "titration_frequency": {
        "value": "Every 24 h or following significant events",
        "provenance": {
          "quote": "Additional measurements were obtained every 24 h afterwards or following significant events, such as ventilator changes, operative interventions, changes in patient positioning, and after wound care was performed.",
          "location": "Methods, Esophageal manometry technique, para 5"
        }
      }
